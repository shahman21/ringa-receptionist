# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Your publicly accessible server URL (use ngrok for local dev)
# e.g. https://abc123.ngrok-free.app
SERVER_URL=https://your-server-url.com

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Vapi (Voice) ─────────────────────────────────────────────────────────────
# Get yours at: https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=...

# Filled in automatically after running `npm run setup:vapi`
VAPI_ASSISTANT_ID=

# ─── Twilio (WhatsApp) ────────────────────────────────────────────────────────
# Get yours at: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Your Twilio WhatsApp-enabled number (format: whatsapp:+447700900000)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Make.com (Calendly Booking) ─────────────────────────────────────────────
# Create a scenario in Make.com with a Webhook trigger → Calendly action
# Paste the webhook URL here
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id
